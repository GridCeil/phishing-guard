# Copy to .env and fill in as needed. Nothing here is required for basic
# heuristic-only checking -- only needed for deep_scan features.

# Get a free key at https://console.cloud.google.com/apis/credentials
# (enable the "Safe Browsing API" first)
GOOGLE_SAFE_BROWSING_API_KEY=

# Shared with the private extension's WXT_API_TOKEN setting.
API_TOKEN=

# Set to "false" to disable WHOIS domain-age lookups entirely
WHOIS_LOOKUP_ENABLED=true

PORT=5000
FLASK_DEBUG=false
